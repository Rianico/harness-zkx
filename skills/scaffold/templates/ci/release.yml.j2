name: Verify and Release
on:
  repository_dispatch:
    types: [semantic-release]
  workflow_dispatch:
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
{% block verify required %}{% endblock %}
  release:
    needs: verify
    runs-on: ubuntu-latest
    permissions:
      contents: write
      issues: write
      pull-requests: write
      id-token: write
    steps:
{% block release %}
      - uses: actions/checkout@{{ shas.checkout }}
        with: { fetch-depth: 0 }
      - uses: actions/setup-node@{{ shas['setup-node'] }} # v7.0.0  # zizmor: ignore[cache-poisoning]
        with: { node-version: {{ node_version }}, cache: npm }
      - run: npm ci
      - run: npx semantic-release
        env:
          GITHUB_TOKEN: {{ gh_actions_token }}
          HUSKY: "0"
{% endblock %}
