{% extends "ci/release.yml.j2" %}
{% block verify %}
      - uses: actions/checkout@{{ shas.checkout }} # v7.0.1
        with: { fetch-depth: 0 }
      - uses: pnpm/action-setup@{{ shas['pnpm-setup'] }} # v6.1.0
        with: { run_install: false }
      - uses: actions/setup-node@{{ shas['setup-node'] }} # v7.0.0  # zizmor: ignore[cache-poisoning]
        with: { node-version: {{ node_version }}, cache: pnpm }
      - run: pnpm install
      - run: pnpm audit --audit-level high
{% if with_coverage %}
      - run: pnpm run {{ coverage_script }}
{% else %}
      - run: pnpm run lint && pnpm run format && pnpm run typecheck && pnpm test
{% endif %}
{% endblock %}
{% block release %}
      - uses: actions/checkout@{{ shas.checkout }} # v7.0.1
        with: { fetch-depth: 0 }
      - uses: pnpm/action-setup@{{ shas['pnpm-setup'] }} # v6.1.0
        with: { run_install: false }
      - uses: actions/setup-node@{{ shas['setup-node'] }} # v7.0.0  # zizmor: ignore[cache-poisoning]
        with: { node-version: {{ node_version }}, cache: pnpm }
      - uses: actions/setup-python@{{ shas['setup-python'] }} # v7.0.0
        with: { python-version: "3.14" }
      - name: Clear Unreleased section and retire the migration baseline
        run: |
          python scripts/changelog-unreleased.py clear
          python scripts/changelog-gate.py ledger --update-baseline
      - run: pnpm install
      - run: pnpm exec semantic-release
        env:
          GITHUB_TOKEN: {{ gh_actions_token }}
          HUSKY: "0"
{% endblock %}
