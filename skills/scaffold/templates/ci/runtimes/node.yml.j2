{% extends "ci/release.yml.j2" %}
{% block verify %}
      - uses: actions/checkout@{{ shas.checkout }} # v5
        with: {fetch-depth: 0}
      - uses: pnpm/action-setup@{{ shas['pnpm-setup'] }} # v4
        with: {run_install: false}
      - uses: actions/setup-node@{{ shas['setup-node'] }} # v5  # zizmor: ignore[cache-poisoning]
        with: {node-version: {{ node_version }}, cache: pnpm}
      - run: pnpm install --no-frozen-lockfile
      - run: pnpm audit --audit-level high
      - run: pnpm run lint && pnpm run format && pnpm run typecheck && pnpm test
{% endblock %}
{% block release %}
      - uses: actions/checkout@{{ shas.checkout }} # v5
        with: {fetch-depth: 0}
      - uses: pnpm/action-setup@{{ shas['pnpm-setup'] }} # v4
        with: {run_install: false}
      - uses: actions/setup-node@{{ shas['setup-node'] }} # v5  # zizmor: ignore[cache-poisoning]
        with: {node-version: {{ node_version }}, cache: pnpm}
      - uses: actions/setup-python@{{ shas['setup-python'] }} # v6
        with: {python-version: "3.12"}
      - name: Clear Unreleased section (handoff to semantic-release)
        run: python scripts/changelog-unreleased.py clear
      - run: pnpm install --no-frozen-lockfile
      - run: pnpm exec semantic-release
        env:
          GITHUB_TOKEN: {{ gh_actions_token }}
          HUSKY: "0"
{% endblock %}
