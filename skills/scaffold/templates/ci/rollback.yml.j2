name: Rollback
on:
  workflow_dispatch:
    inputs:
      target_ref:
        description: 'Tag or SHA to roll main back to (e.g. v1.2.3). The current tip is backed up as a rollback-backup tag first.'
        required: true
        type: string
permissions:
  contents: write
jobs:
  rollback:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@{{ shas.checkout }} # v7.0.1
        with: { fetch-depth: 0 }
      - name: Verify the target ref resolves
        env:
          TARGET_REF: {{ target_ref }}
        run: |
          git rev-parse --verify "$TARGET_REF^{commit}"
      - name: Back up current main
        env:
          RUN_ID: {{ run_id }}
        run: |
          git tag "rollback-backup-$RUN_ID"
          git push origin "rollback-backup-$RUN_ID"
      - name: Roll back main to the target ref
        # Branch protection may refuse the force-push; then open the revert as a PR instead.
        env:
          TARGET_REF: {{ target_ref }}
        run: |
          git push origin "$TARGET_REF:refs/heads/main" --force
